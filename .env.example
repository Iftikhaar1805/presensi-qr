# Salin menjadi .env (lokal) atau isi di Vercel > Settings > Environment Variables.
# Kosongkan DATABASE_URL untuk memakai file lokal data/presensi.db. TURSO_DATABASE_URL dan TURSO_AUTH_TOKEN juga dikenali.
DATABASE_URL=libsql://NAMA-DB-ANDA.turso.io
DATABASE_AUTH_TOKEN=
# Kunci tanda tangan login. Isi teks acak panjang (jalankan: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
JWT_SECRET=
# Opsional: 1 = tampilkan tombol akun contoh di halaman masuk (hanya untuk latihan). Kosong = disembunyikan.
SHOW_DEMO_ACCOUNTS=
